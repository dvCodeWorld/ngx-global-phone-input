  "description": "A comprehensive Angular library for international phone number input with country selection, validation using Google's libphonenumber, auto-detection, and Material Design integration.",
  "author": "ngx-global-phone-input",
  "license": "MIT",
  "homepage": "https://github.com/yourusername/ngx-global-phone-input#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/ngx-global-phone-input.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/ngx-global-phone-input/issues"
  },
  "keywords": [
    "angular",
    "ngx",
    "phone",
    "international",
    "input",
    "material",
    "global",
    "component",
    "libphonenumber",
    "validation",
    "country-code",
    "dial-code",
    "mobile",
    "telephone",
    "form-control",
    "reactive-forms",
    "angular-material",
    "typescript"
  ],
  "main": "bundles/ngx-global-phone-input.umd.js",
  "module": "fesm2022/ngx-global-phone-input.mjs",
  "es2020": "fesm2020/ngx-global-phone-input.mjs",
  "esm2020": "esm2020/ngx-global-phone-input.mjs",
  "fesm2020": "fesm2020/ngx-global-phone-input.mjs",
  "fesm2022": "fesm2022/ngx-global-phone-input.mjs",
  "typings": "index.d.ts",
  "exports": {
    "./package.json": {
      "default": "./package.json"
    },
    ".": {
      "types": "./index.d.ts",
      "esm2020": "./esm2020/ngx-global-phone-input.mjs",
      "es2020": "./fesm2020/ngx-global-phone-input.mjs",
      "es2015": "./fesm2015/ngx-global-phone-input.mjs",
      "node": "./fesm2015/ngx-global-phone-input.mjs",
      "default": "./fesm2022/ngx-global-phone-input.mjs"
    }
  },
  "peerDependencies": {
    "@angular/core": ">=16.0.0 <20.0.0",
    "@angular/common": ">=16.0.0 <20.0.0",
    "@angular/material": ">=16.0.0 <20.0.0",
    "@angular/cdk": ">=16.0.0 <20.0.0",
    "@angular/forms": ">=16.0.0 <20.0.0",
    "google-libphonenumber": "^3.2.0"
  },
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  }
